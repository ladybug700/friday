# Copy this file to a private location (NOT committed) and source it from start.sh,
# or paste these exports into your ~/.bashrc on the phone.
#
#   cp .env.example ~/.friday.env
#   chmod 600 ~/.friday.env
#   source ~/.friday.env && bash start.sh

# Required — your Ollama Cloud key (https://ollama.com). Never commit this.
export OLLAMA_API_KEY="REPLACE_ME"

# Optional — override default models.
export PRIMARY_MODEL="gemma4:31b-cloud"
export FALLBACK_MODEL="gpt-oss:120b"

# Optional — Ollama host (default already correct for Ollama Cloud).
# export OLLAMA_HOST="https://ollama.com"

# Optional — Termux Chromium path (default already correct for stock Termux).
# export CHROMIUM_PATH="/data/data/com.termux/files/usr/bin/chromium-browser"

# Optional — server port (default 3000).
# export PORT="3000"
