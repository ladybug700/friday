# Termux on Android isn't on puppeteer's supported-platforms list, so its
# postinstall script fails when it tries to download a Chromium binary.
# We don't need it — bot.js launches the system Chromium installed via
# `pkg install chromium` (CHROMIUM_PATH in start.sh).
#
# Both keys are kept for compatibility: newer puppeteer (>=19) reads
# PUPPETEER_SKIP_DOWNLOAD; older versions read PUPPETEER_SKIP_CHROMIUM_DOWNLOAD.
puppeteer_skip_download=true
puppeteer_skip_chromium_download=true
